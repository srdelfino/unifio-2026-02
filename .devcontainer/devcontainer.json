{
  "name": "Projeto",

  "build": {
    "dockerfile": "Dockerfile"
  },

  // Abre as portas do container no computador do aluno (host):
  //   8080 -> API Spring Boot (testar no navegador)
  //   3306 -> MySQL (conectar com Workbench/DBeaver)
  "forwardPorts": [8080, 3306],

  "customizations": {
    "vscode": {
      // Extensões instaladas automaticamente no VS Code.
      "extensions": [
        "ms-azuretools.vscode-docker",
        "vscjava.vscode-java-pack",
        "vmware.vscode-spring-boot",
        "cweijan.vscode-mysql-client2"
      ],

      "settings": {
        "workbench.colorTheme": "Dark Modern",
        "editor.fontSize": 20,
        "terminal.integrated.fontSize": 20
      }
    }
  },

  // Só na CRIAÇÃO do container: sobe o MySQL e cria banco/usuário.
  "postCreateCommand": "/bin/bash .devcontainer/init-mysql.sh",
  // Em TODO start do container: garante o MySQL rodando (no-op se já estiver).
  "postStartCommand": "service mysql start"
}
